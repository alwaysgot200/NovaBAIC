<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 2026-10-20 通报方案 §4：H 接管/G 达成铃声通知的锁屏全屏横幅（普通权限）。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- 真机仪器测试的节点树解锁降级通道（签名级权限，仅 adb pm grant 后生效，生产永不授予）。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- RPA 关闭应用：ActivityManager.killBackgroundProcesses（普通权限，装机授予）。 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 内置安装 Shizuku（docs/2026-10-26-内置安装Shizuku方案.md）：普通权限，
         无运行时弹窗；用户需在系统「安装未知应用」里为本应用放行。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- M2-a 起草档：通知监听（BIND 由系统授予，非运行时权限） -->
    <!-- assists 合并治理（R1）：移除 assists-base 带入的联系人写权限，本应用无此用途 -->
    <uses-permission
        android:name="android.permission.WRITE_CONTACTS"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <!-- 内置安装/检测 Shizuku：显式声明包可见性，不依赖 QUERY_ALL_PACKAGES 兜底 -->
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".Baic2Application"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BAIC2">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            tools:ignore="MissingClass" />

        <!-- 内置 Shizuku 安装包（assets/shizuku.apk）经缓存目录以 content:// 交给系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shizukuinstaller"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shizuku_installer_paths" />
        </provider>

        <!-- RPA 脚本导出分享：cacheDir/rpa_export/ 下的 .json/.xml/.rpa 以 content:// 分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.rpaexport"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rpa_export_paths" />
        </provider>

        <!-- 好参谋自更新：系统 PackageInstaller 会话安装结果回调 -->
        <receiver
            android:name=".floatball.update.UpdateInstallReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".floatball.FloatBallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on-top floating ball quick entry overlaying other apps" />
        </service>

        <!-- RPA 后台运行：独立于脚本库/编辑器页面，运行期间经 RpaChromeGate 隐藏悬浮球 -->
        <service
            android:name=".floatball.rpa.RpaRunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="RPA automation script execution over other apps" />
        </service>

        <activity
            android:name=".floatball.FloatCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".floatball.FloatSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_settings_title" />
        <activity
            android:name=".floatball.account.AccountActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_account_manage_title" />
        <activity
            android:name=".floatball.account.RechargeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_recharge_title" />

        <activity
            android:name=".floatball.AdvisorProfileActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_profile_title" />

        <!-- 投影免弹窗授权（docs/2026-10-21-投影免弹窗授权方案.md）：Shizuku + appops，设置页权限分区入口 -->
        <activity
            android:name=".floatball.shizuku.ShizukuGrantActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_shizuku_title" />

        <activity
            android:name=".floatball.StyleCardActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_style_entry" />

        <activity
            android:name=".floatball.StrategyCardActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_goal_card_entry" />

        <activity
            android:name=".floatball.AdvisorPlaybookActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_playbook_title" />

        <!-- RPA 自动化：脚本库 / 可拖拽编排 / 布局分析器 / 以图找图（vendor/RPA 独立模块）。
             singleTop：通知栏结果点开与悬浮菜单入口复用同一实例，避免叠多层脚本库。 -->
        <activity
            android:name=".floatball.rpa.RpaActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_rpa_title"
            android:launchMode="singleTop" />

        <!-- 以图找图：透明全屏结果浮层（无 a11y；不铺截图，目标 App 保持可见）。
             不能用 noHistory：PickVisualMedia 选图期间本页被系统照片选择器覆盖，
             noHistory 会提前销毁本页，结果回调再也回不来。 -->
        <activity
            android:name=".floatball.rpa.quickfind.RpaQuickFindActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/float_rpa_quickfind_title"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- VA-2 U1：全局我方人设标签库（floatball 自有页面，入口在画像页「我的人设」屏顶部） -->
        <activity
            android:name=".floatball.SelfPersonaLibraryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_selfpersona_title" />

        <!-- 使用帮助（扇形菜单「帮助」子球入口） -->
        <activity
            android:name=".floatball.AdvisorHelpActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_help_title" />

        <!-- 关于（「更多」弹窗末项入口，复用主框架设置的关于页内容） -->
        <activity
            android:name=".floatball.AdvisorAboutActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_more_about" />

        <!-- 好参谋保活：开机/更新自启（受保护广播，exported 必须 true） -->
        <receiver
            android:name=".keepalive.KeepAliveBootReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="IntentFilterExportedReceiver">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 心跳兜底闹钟（应用内事件，不导出） -->
        <receiver
            android:name=".keepalive.KeepAliveAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.verlintas.baic2.keepalive.action.HEARTBEAT_ALARM" />
            </intent-filter>
        </receiver>

        <!-- 心跳 JobService（周期下限 15 分钟，由系统排程） -->
        <service
            android:name=".keepalive.KeepAliveHeartbeatJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 可选无声音乐：仅前台开启或闹钟/白名单路径复活，绝不从 BOOT 启动 -->
        <service
            android:name=".keepalive.KeepAliveMusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 保活设置页 -->
        <activity
            android:name=".keepalive.KeepAliveSettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:label="@string/float_keepalive_title" />

        <!-- 首启保活引导卡片（2026-10-22）：初装首次启动弹一次，三项授权逐项去开启。
             不设 noHistory：跳系统页后必须能返回卡片刷新状态，卡片靠「完成」收尾。
             与主窗同一任务（不设 taskAffinity/NEW_TASK）：系统里同时只留一扇本应用窗口。 -->
        <activity
            android:name=".keepalive.KeepAliveSetupGuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- M2-a 起草档：聊天通知监听（仅白名单 IM、未建档联系人静默忽略） -->
        <service
            android:name=".floatball.director.AdvisorNotificationListener"
            android:exported="false"
            android:label="@string/float_draft_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- M2-b 主动保温：周期检点闹钟（应用内事件，不导出；开机重挂经 FloatBallService.onCreate） -->
        <receiver
            android:name=".floatball.director.ProactiveCheckpointReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.verlintas.baic2.floatball.action.PROACTIVE_TICK" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
