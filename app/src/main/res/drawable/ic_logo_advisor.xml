<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ 老参谋品牌标识：白羽扇（军师参谋意象）+ AI 星光。
  ~ 应用自适应图标前景层与悬浮球共用本文件，保持单一 logo 来源。
  ~ 2026-10 重绘（放大、简化）：扇面占视口约 68%（旧版约 52%），
  ~ 五片羽尖、三根扇骨、单颗大星，去掉小尺寸下不可见的细碎结构，
  ~ 保证 56dp 悬浮球内剪影仍一眼可辨。
  ~ 注意：dev/render-brand-assets.py 中的几何数据须与本文件保持一致，
  ~ 改动后重跑该脚本同步全部位图素材。
  -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 扇柄（先绘，压在扇面与铆钉之下） -->
    <path
        android:pathData="M51.6,66.4 L56.4,66.4 L56.4,84.2 a2.4,2.4 0 0 1 -4.8,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="66"
                android:endX="54" android:endY="87">
                <item android:offset="0" android:color="#FFEAC571" />
                <item android:offset="1" android:color="#FFB9872F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 扇面：七片白羽沿凸圆弧浅起伏，小尺寸下读作完整扇贝 -->
    <path
        android:pathData="M46.0,64.1 L18.3,54.0
            Q23.8,48.4 26.4,40.9
            Q33.6,37.9 38.9,32.1
            Q46.8,32.2 54.0,29.0
            Q61.2,32.2 69.1,32.1
            Q74.4,37.9 81.6,40.9
            Q84.2,48.4 89.7,54.0
            L62.0,64.1 Q54.0,68.8 46.0,64.1 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="29"
                android:endX="54" android:endY="69">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFD0E0F9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 两侧保护骨（白亮边，强化扇贝外轮廓） -->
    <path
        android:strokeColor="#F2F8FF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M54,67 L18.3,54.0 M54,67 L89.7,54.0" />

    <!-- 三根主扇骨：自扇轴向羽尖辐射 -->
    <path
        android:strokeColor="#4D4B86C8"
        android:strokeWidth="1.25"
        android:strokeLineCap="round"
        android:pathData="M54,67 L38.9,32.1 M54,67 L54,29 M54,67 L69.1,32.1" />

    <!-- 扇轴铆钉 -->
    <path android:pathData="M54,67 m-3.4,0 a3.4,3.4 0 1 0 6.8,0 a3.4,3.4 0 1 0 -6.8,0 Z"
        android:fillColor="#F2CE74" />
    <path android:pathData="M54,67 m-1.75,0 a1.75,1.75 0 1 0 3.5,0 a1.75,1.75 0 1 0 -3.5,0 Z"
        android:fillColor="#8A5E1C" />

    <!-- AI 星光（单颗，四角星，放大醒目） -->
    <path
        android:fillColor="#FF9FECFF"
        android:pathData="M79.5,24.2 L81.2,28.3 L85.3,30.0 L81.2,31.7 L79.5,35.8 L77.8,31.7 L73.7,30.0 L77.8,28.3 Z" />
</vector>
