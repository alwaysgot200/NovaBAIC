<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Loopback traffic is not remotely interceptable; this lets developer
         tooling (dev/mock-*.py over adb reverse) run against release builds too. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- 局域网测试服务器（autojs6_Management GitLab CI 部署，server.origin.test） -->
        <domain includeSubdomains="false">192.168.1.27</domain>
    </domain-config>
</network-security-config>
