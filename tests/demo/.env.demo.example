# 复制为 .env.demo 并填写（不要提交真实 key）
# 服务端演示数据导入时使用；缺省回退到容器已有的 DEEPSEEK_API_KEY。
DEMO_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LiteLLM Admin API（dev 容器默认值）
LITELLM_BASE_URL=http://autojs6-litellm:4000
LITELLM_MASTER_KEY=sk-local-dev-litellm-master-key

# 可选：显式指定测试服务器地址（留空由 net.ps1 自动探测局域网 IP）
NOVA_TEST_ORIGIN=

# 设备序列号（多设备时指定）
ADB_SERIAL=449c98301422
